# create actor
@ray.remote
class Counter:

    # constructor
    def __init__(self):

        # initialize count
        self.count = 0

    # increment method
    def increment(self):

        # add one
        self.count += 1

        # return value
        return self.count

# create actor
counter = Counter.remote()

# call actor method
print(
    ray.get(
        counter.increment.remote()
    )
)


